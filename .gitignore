# tests/fixtures/ IS tracked on purpose (the eval set and SERP captures are how
# scoring gets tuned). The people in it are synthetic.

# ════════════════ YOUR PERSONAL FILES — never committed ════════════════
# Each has a tracked example that loads (or that `make setup` copies) until
# your own version exists.

# Your CV / cover-letter profile. profile.example/ is the made-up template.
profile/

# The job search's personal answers — work authorisation, skills, CV text.
config/job_search.yaml
config/my_skills.yaml
config/my_profile.md
# The companies you target, and the people-search lists.
config/target_companies.csv
config/companies.csv
config/roles.csv
config/*.bak*
config/seed/

# API keys. Only .env.example (empty values) is tracked.
.env
.env.*
!.env.example

# Local editor / assistant settings.
.claude/

# ── the CV / cover-letter engine ──
# Per-run intermediates: analyses, drafts, rejected letters, trace.jsonl,
# and your own letter ratings (run/voice_eval.csv).
run/
# Generated applications. Personal, and regenerable from profile/ + the job id.
output/
output
